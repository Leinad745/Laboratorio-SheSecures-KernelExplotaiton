# kernel-min.config — Fragmento de configuración para el kernel del laboratorio
# ---------------------------------------------------------------------------
# NO es un .config completo (esos tienen miles de líneas y dependen de la versión).
# Es un FRAGMENTO que se fusiona sobre `make defconfig` para dejar un kernel
# mínimo y SIN mitigaciones, apto para la demo didáctica.
#
# Uso (opción B del README), dentro del árbol del kernel (linux-6.x):
#
#     make defconfig
#     ./scripts/kconfig/merge_config.sh .config /ruta/lab/kernel-min.config
#     make -j"$(nproc)" bzImage
#     cp arch/x86/boot/bzImage /ruta/lab/bzImage
#
# merge_config.sh aplicará estas opciones sobre defconfig y avisará de cualquier
# conflicto. Luego compila `vuln.ko` con KDIR apuntando a ESTE árbol.

# --- Arquitectura y arranque ---
CONFIG_64BIT=y
CONFIG_BLK_DEV_INITRD=y          # arrancar desde initramfs
CONFIG_BINFMT_ELF=y              # ejecutar binarios ELF (el exploit)

# --- Consola serie (necesaria para -nographic / console=ttyS0) ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_UNIX98_PTYS=y             # ptys para la shell interactiva (cttyhack)

# --- /dev, /proc, /sys ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y                 # /proc/kallsyms lo usa el exploit
CONFIG_SYSFS=y

# --- Módulos (necesitamos cargar/descargar vuln.ko) ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_SIG is not set          # NO exigir firma de módulos
# CONFIG_MODULE_SIG_FORCE is not set

# --- Símbolos legibles para el exploit ---
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# =========================================================================
# MITIGACIONES DESACTIVADAS A PROPÓSITO (solo laboratorio, jamás en producción)
# =========================================================================
# KASLR off: direcciones de kernel estables -> símbolos predecibles
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RANDOMIZE_MEMORY is not set

# Sin canario de pila: el desbordamiento alcanza la dirección de retorno
# CONFIG_STACKPROTECTOR is not set
# CONFIG_STACKPROTECTOR_STRONG is not set

# Sin KPTI: el retorno a userland con iretq es directo (sin trampolín)
# CONFIG_PAGE_TABLE_ISOLATION is not set

# Sin retpoline / mitigaciones de CPU (kernels >= 6.8 usan el interruptor maestro)
# CONFIG_MITIGATION_RETPOLINE is not set
# CONFIG_CPU_MITIGATIONS is not set
# CONFIG_RETPOLINE is not set

# Nota: SMEP y SMAP se controlan también por hardware/línea de comandos
# (nosmep nosmap en run.sh), por eso no hace falta tocarlos aquí.
